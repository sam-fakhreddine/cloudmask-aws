{
  "version": 1,
  "languages": [
    {
      "name": "python",
      "formatter": "black",
      "linter": "ruff",
      "test_framework": "pytest",
      "include_patterns": ["**/*.py"],
      "exclude_patterns": ["venv/**", ".venv/**", "build/**", "dist/**", "*.egg-info/**", "__pycache__/**"]
    }
  ],
  "quality_gate": {
    "enabled": true,
    "fail_on_error": true
  }
}
